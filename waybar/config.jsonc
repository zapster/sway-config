{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/ethernet",
    "network#wifi",
    "pulseaudio",
    "backlight",
    "battery",
    "tray",
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false
  },
  "sway/mode": {
    "format": "{}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 2,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}\nClick: mute · Scroll: volume · Right-click: mixer"
  },
  "backlight": {
    "format": "  {percent}%",
    "tooltip-format": "Display brightness: {percent}%"
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo} · {power:.1f} W",
    "format-discharging": "{icon}  {capacity}% · {power:.1f} W",
    "interval": 5
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2,
    "tooltip-format": "CPU usage: {usage}%\nLoad: {load}\nAverage frequency: {avg_frequency:.2f} GHz"
  },
  "memory": {
    "format": "RAM {used:.1f}G",
    "interval": 5,
    "tooltip-format": "RAM: {used:.1f} / {total:.1f} GiB\nAvailable: {avail:.1f} GiB\nSwap: {swapUsed:.1f} / {swapTotal:.1f} GiB"
  },
  "network#wifi": {
    "interface": "wl*",
    "format": "  Wi-Fi",
    "format-wifi": "  {essid} · {ipaddr}",
    "format-linked": "  Wi-Fi · no IP",
    "format-disconnected": "  Wi-Fi disconnected",
    "format-disabled": "  Wi-Fi off",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nRight-click: Wi-Fi settings",
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\n{ifname}: {ipaddr}/{cidr}\nRight-click: Wi-Fi settings",
    "tooltip-format-disconnected": "Wi-Fi disconnected\nRight-click: Wi-Fi settings",
    "tooltip-format-disabled": "Wi-Fi radio off\nRight-click: Wi-Fi settings",
    "on-click-right": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi",
    "max-length": 48,
    "interval": 5
  },
  "custom/ethernet": {
    "exec": "$HOME/.config/sway/scripts/ethernet-status",
    "return-type": "json",
    "interval": 5,
    "on-click-right": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center network"
  }
}
